#!/bin/bash
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: arch-why <package>"
    echo ""
    echo "Explains why a package is installed on your Arch Linux system."
    echo ""
    echo "Examples:"
    echo "  arch-why firefox"
    echo "  arch-why vim"
    echo ""
    echo "Options:"
    echo "  -h, --help    Show this message"
    exit 0
fi
PKG=$1
if [ -z "$PKG" ]; then
    echo "Usage: arch-why <package>"
    exit 1
fi
if ! pacman -Qi "$PKG" &>/dev/null; then
    echo "Package not found"
    exit 1
fi
# Force English output
INFO=$(LANG=C pacman -Qi "$PKG")
# Capitalized name
NAME=$(echo "$PKG" | sed 's/.*/\u&/')
# Install reason
if echo "$INFO" | grep -q "Explicitly installed"; then
    REASON="Installed manually"
else
    REASON="Installed as a dependency"
fi
# Required by
REQ=$(echo "$INFO" | grep "Required By" | sed 's/.*: //')
if [[ "$REQ" == "None" ]]; then
    REQ="None"
fi
# Dependencies
DEPS=$(echo "$INFO" | grep "Depends On" | sed 's/.*: //')
if [[ "$DEPS" == "None" ]]; then
    DEPS="None"
fi
# Final output
echo ""
echo "$NAME: $REASON"
echo ""
echo "Required by: $REQ"
echo ""
echo "Dependencies: $DEPS"
echo ""
